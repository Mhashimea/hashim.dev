# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal planning notes (contains phone + strategy) and dev artifacts
/docs/
/shots/
/.playwright-mcp/

# macOS / editor junk
.DS_Store
*.local

# secrets (belt-and-suspenders — .env* already covers these)
.env
.envrc
.dev.vars
.wrangler
